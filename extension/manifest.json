{
  "name": "autoJob - Job Tracker & Auto-Applier",
  "description": "Save jobs from any career site with one click. Auto-track applications, practice interviews, optimize LinkedIn.",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost:3000/*",
    "https://your-production-domain.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://in.linkedin.com/jobs/*",
        "https://www.naukri.com/*",
        "https://www.naukri.com/job-listings-*",
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://www.accenture.com/*",
        "https://careers.accenture.com/*",
        "https://*.glassdoor.com/*",
        "https://*.monster.com/*",
        "https://*.dice.com/*",
        "https://*.wellfound.com/*",
        "https://*.angel.co/*",
        "https://*.lever.co/*",
        "https://*.greenhouse.io/*",
        "https://*.workday.com/*",
        "https://*.icims.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.bamboohr.com/*",
        "https://*.jobvite.com/*",
        "https://*.taleo.net/*",
        "https://*.oraclecloud.com/*",
        "https://*.successfactors.com/*",
        "https://*.workable.com/*",
        "https://*.recruitee.com/*",
        "https://*.personio.de/*",
        "https://*.teamtailor.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.join.com/*",
        "https://*.welcometothejungle.com/*",
        "https://careers.*/*",
        "https://jobs.*/*",
        "https://*.careers.*/*",
        "https://*.jobs.*/*"
      ],
      "js": ["content/universal.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "autoJob",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://*/*", "http://localhost:3000/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}